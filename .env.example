# -----------------------------------------------------------------------------
# ZULO Environment Variables Example
# Duplicate this file to `.env` and fill in your actual credentials.
# -----------------------------------------------------------------------------

# Database connection pooled (for Prisma queries via Supabase Supavisor pooler, port 6543)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct database connection (for Prisma migrations / db push, port 5432)
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Project URL & Publishable / Anon Key
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="sb_publishable_[YOUR_ANON_KEY]"

# Site URL for canonical links and auth redirects
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
